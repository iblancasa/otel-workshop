<?xml version="1.0" encoding="UTF-8"?>
<!-- Console only. The OpenTelemetry Java agent hooks the Log4j appender
     pipeline itself; nothing here mentions OpenTelemetry. -->
<Configuration status="warn">
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} %M - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="stdout"/>
    </Root>
  </Loggers>
</Configuration>
