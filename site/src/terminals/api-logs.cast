[0.021359, "o", "\u001b[1;32m$\u001b[0m TID=$(curl -s 'localhost:3000/api/traces?limit=200' | python3 -c 'import sys,json; print([t[\"trace_id\"] for t in json.load(sys.stdin)[\"traces\"] if t[\"duration\"] > 5e9 and t[\"root_span_name\"]==\"POST /api/checkout\"][0])')\r\n"]
[0.84793, "o", "\u001b[1;32m$\u001b[0m curl -s \"localhost:3000/api/logs?trace_id=$TID\" | python3 -c 'import sys,json; [print(l[\"resource\"][\"attributes\"][\"service.name\"].ljust(9), l[\"severity\"].ljust(5), l[\"body\"][:110]) for l in reversed(json.load(sys.stdin)[\"logs\"])]'\r\n"]
